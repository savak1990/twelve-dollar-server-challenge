[Unit]
Description=Twelve-dollar challenge API (submission under test)
After=network.target

[Service]
User=app
Group=app
WorkingDirectory=/srv/app
Environment=SQLITE_PATH=/srv/app/feed.db
Environment=JWT_SECRET=twelve-dollar-challenge
Environment=HOST=0.0.0.0
Environment=PORT=80
# Experiment-only extras (PROFILE_DIR, GODEBUG, ...); absent in the upstream benchmark.
EnvironmentFile=-/srv/app/twelve.env
ExecStart=/srv/app/submission/start.sh
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
